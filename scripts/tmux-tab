#!/usr/bin/env bash

# Create a new tmux window without switching to it.
#
#   tmux-tab [-n|--name NAME] [-d|--dir DIR] [COMMAND...]
#
# The window is created in $TMUX_SESSION if set, otherwise in the current
# session. It starts in that session's root directory, or in DIR below it.
# COMMAND is typed into the window's shell, so the shell survives the command
# exiting.

usage() {
    echo "usage: tmux-tab [-n NAME] [-d DIR] [COMMAND...]" >&2
    exit 1
}

name=""
dir=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -n|--name) [[ $# -lt 2 ]] && usage; name=$2; shift 2 ;;
        -d|--dir)  [[ $# -lt 2 ]] && usage; dir=$2;  shift 2 ;;
        --)        shift; break ;;
        -?*)       usage ;;
        *)         break ;;
    esac
done

session=${TMUX_SESSION:-$(tmux display-message -p '#S')}
root=$(tmux display-message -p -t "$session:" '#{session_path}') || exit 1

case $dir in
    "")  ;;
    /*)  root=$dir ;;
    *)   root="$root/$dir" ;;
esac

new_window=(tmux new-window -d -P -F '#{window_id}' -t "$session:" -c "$root")
[[ -n $name ]] && new_window+=(-n "$name")

window=$("${new_window[@]}") || exit 1

if [[ $# -gt 0 ]]; then
    tmux send-keys -t "$window" "$*" C-m
fi
