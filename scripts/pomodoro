#! /usr/bin/env python

import time
import subprocess
from tqdm import tqdm
import argparse
import sys


def setup_argparser():
    parser = argparse.ArgumentParser(description='A simple pomodoro timer')
    parser.add_argument('num_sessions', nargs='?', default=None, type=int,
                        metavar='num-sessions',
                        help='the number of sessions (asked interactively if omitted)')
    parser.add_argument('--session', default=25, type=int,
                        help='the length of a session in minutes')
    parser.add_argument('--break', dest='break_', metavar='BREAK',
                        default=5, type=int,
                        help='the length of a break between sessions in minutes')
    return parser


def send_notification(summary, body=''):
    if sys.platform == "linux":
        subprocess.run(['notify-send', summary, body])
    elif sys.platform == "darwin":
        subprocess.run(
            ["osascript", "-e", f"display notification \"{body}\" with title \"{summary}\""])
    else:
        raise f"Unable to send notification on unknown system '{sys.platform}'"


def set_terminal_title(title):
    print(f'\033]2;{title}\a', end='', flush=True)


def format_remaining_str(remaining, prefix="Pomodoro timer. Time remaining: "):
    seconds = remaining % 60
    minutes = remaining // 60
    hours = minutes // 60
    minutes %= 60

    l = [minutes, seconds]
    if hours > 0:
        l.insert(0, hours)

    return prefix + ':'.join(map(lambda x: str(x).zfill(2), l))


def ask_int(prompt, minimum=1):
    while True:
        answer = input(prompt).strip()
        try:
            value = int(answer)
        except ValueError:
            print(f"'{answer}' is not a number")
            continue
        if value < minimum:
            print(f'Please enter a number of at least {minimum}')
            continue
        return value


def timer(minutes=0, seconds=0, desc='Progress: ',
          title_prefix='Pomodoro timer. Time remaining: '):
    seconds += 60 * minutes
    set_terminal_title(format_remaining_str(seconds, prefix=title_prefix))
    timer_range = range(1, seconds+1)
    with tqdm(total=seconds, position=0, leave=True) as pbar:
        for i in tqdm(timer_range, position=0, leave=True,
                      desc=desc,
                      bar_format='{desc} |{bar}| ({remaining} remaining)'):
            time.sleep(1.0)
            pbar.update()
            set_terminal_title(format_remaining_str(
                seconds-i, prefix=title_prefix))


def run_pomodoro(num_sessions, session_minutes, break_minutes, intent):
    for session in range(1, num_sessions+1):
        label = f'Session {session}/{num_sessions}'
        print(f'\n{label}: {intent}' if intent else f'\n{label}')
        timer(minutes=session_minutes, desc=f'{label}: ',
              title_prefix=f'{label}. Time remaining: ')
        send_notification(f'{label} is over', 'Time for a break')

        if session == num_sessions:
            break

        set_terminal_title(f'{label} is over. Break pending')
        input('Press Enter to start the break. ')

        print(f'\nBreak {session}/{num_sessions-1}')
        timer(minutes=break_minutes, desc='Break: ',
              title_prefix='Break. Time remaining: ')
        send_notification('The break is over',
                          f'Ready for session {session+1}/{num_sessions}?')

        set_terminal_title('Break is over. Next session pending')
        input(f'Press Enter when you finished the break '
              f'to start session {session+1}/{num_sessions}. ')

    send_notification('Pomodoro finished',
                      f'{num_sessions} session(s) done' + (f': {intent}' if intent else ''))


if __name__ == '__main__':
    args = setup_argparser().parse_args()

    intent = input('What is the intent of this session? ').strip()
    num_sessions = args.num_sessions
    if num_sessions is None:
        num_sessions = ask_int('How many sessions do you want to do? ')

    set_terminal_title('Pomodoro timer')
    try:
        run_pomodoro(num_sessions, args.session, args.break_, intent)
    except KeyboardInterrupt:
        print('\nPomodoro aborted')
        sys.exit(130)

    print(f'\nDone. {num_sessions} session(s) of {args.session} minutes'
          + (f' on: {intent}' if intent else ''))
    set_terminal_title('Pomodoro finished')
