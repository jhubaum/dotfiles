#!/usr/bin/env bash

# Pick a tmux session with fzf and switch to it. The current session is
# marked with a *.

current=$(tmux display-message -p '#S')

selected=$(
    tmux list-sessions -F '#S' |
        awk -v cur="$current" '{ print ($0 == cur ? "* " : "  ") $0 }' |
        fzf --reverse --preview 'tmux capture-pane -ep -t "$(echo {} | cut -c3-):"'
)

if [[ -z $selected ]]; then
    exit 0
fi

tmux switch-client -t "=${selected:2}"
